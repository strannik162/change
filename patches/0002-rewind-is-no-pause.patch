From 9fd6dfeda4f09b6c9792c0dd4bdc30a8f252e432 Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Sat, 28 Nov 2026 11:03:03 +0000
Subject: [PATCH] timeline: rewind is no pause, playback goes on when the key
 is let go

---
 src/user_interface/timeline/timeline_interaction.c | 11 +++++++++--
 src/user_interface/timeline/timeline_types.h       |  1 +
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/user_interface/timeline/timeline_interaction.c b/src/user_interface/timeline/timeline_interaction.c
index 905db83..e4f86e2 100644
--- a/src/user_interface/timeline/timeline_interaction.c
+++ b/src/user_interface/timeline/timeline_interaction.c
@@ -278,8 +278,15 @@ void interaction_handle_playback_and_shortcuts(timeline_state_t *ts) {
   bool reverse_down =
       keybinds_is_action_down(&ts->ui->keybinds, ACTION_REWIND_HOLD) || keybinds_is_action_pressed(&ts->ui->keybinds, ACTION_REWIND_HOLD, false);
 
-  if (reverse_down && !ts->is_reversing) ts->last_update_time = igGetTime();
-  if (!reverse_down && ts->is_reversing) ts->last_update_time = igGetTime();
+  if (reverse_down && !ts->is_reversing) {
+    ts->last_update_time = igGetTime();
+    // Rewinding is no pause: whatever was playing plays on once the key is let go.
+    ts->resume_after_rewind = ts->is_playing;
+  } else if (!reverse_down && ts->is_reversing) {
+    ts->last_update_time = igGetTime();
+    if (ts->resume_after_rewind) ts->is_playing = true;
+    ts->resume_after_rewind = false;
+  }
 
   ts->is_reversing = reverse_down;
   if (ts->is_reversing) ts->is_playing = false;
diff --git a/src/user_interface/timeline/timeline_types.h b/src/user_interface/timeline/timeline_types.h
index 1d3a6c7..5f5c2bd 100644
--- a/src/user_interface/timeline/timeline_types.h
+++ b/src/user_interface/timeline/timeline_types.h
@@ -302,6 +302,7 @@ struct timeline_state {
   bool recording;
   int recording_start_tick; // where the playhead was when the recording started, for discarding it
   bool is_reversing;
+  bool resume_after_rewind; // playback went on after the rewind key is let go, it was playing before it
   bool linked_copy_input;
 
   // Data Model
-- 
2.39.5

